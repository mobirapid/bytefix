PORT=3000

# Production: point the database at a persistent disk, e.g. /data/regear.db
# DB_PATH=/data/regear.db

# OTP delivery
# Demo mode (default): the code is shown on screen and logged. Set to false in production.
DEV_OTP=true

# --- Email delivery via Resend (optional) ---
# When RESEND_API_KEY is set, order emails are delivered for real; otherwise they're
# logged to the console (demo). MAIL_FROM must use a domain verified in your Resend account.
# RESEND_API_KEY=re_your_key_here
# MAIL_FROM=ReGear <updates@regear.in>

# Static OTP (pilot): a fixed code that always verifies for any number, no SMS sent —
# lets you take bookings before SMS is live. Defaults to 123456 while in demo mode.
# Disables automatically when DEV_OTP=false or MSG91 is configured.
# STATIC_OTP=123456

# --- Live OTP via MSG91 (optional) ---
# When MSG91_AUTHKEY and MSG91_TEMPLATE_ID are set, codes are sent by real SMS
# instead of shown on screen. Create a DLT-approved OTP template in MSG91 with a
# single variable for the code, and set MSG91_OTP_VAR to that variable's name.
# MSG91_AUTHKEY=your_msg91_authkey
# MSG91_TEMPLATE_ID=your_flow_template_id
# MSG91_OTP_VAR=otp
# SMS_COUNTRY_CODE=91
